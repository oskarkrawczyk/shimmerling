{
  "name": "shimmerling",
  "version": "0.2.1",
  "description": "An iridescent, noise-warped wave that sweeps across an element's background and ends in a turning border glow. Plain JS, with React and Vue wrappers.",
  "license": "MIT",
  "author": "Oskar Krawczyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskarkrawczyk/shimmerling.git"
  },
  "homepage": "https://github.com/oskarkrawczyk/shimmerling#readme",
  "bugs": "https://github.com/oskarkrawczyk/shimmerling/issues",
  "keywords": [
    "animation",
    "shimmer",
    "wave",
    "iridescent",
    "glow",
    "effect",
    "react",
    "vue"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.js",
    "build:demo": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vue": "^3.5.46"
  }
}
